# Discord — create a webhook in your server: Channel Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=

# Telegram — token from @BotFather, chat id from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email (SMTP). For Gmail use an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
